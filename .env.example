# Copy to .env and fill in your provider.
# Any OpenAI-compatible endpoint works: OpenAI, DeepSeek, Qwen, Kimi, GLM, etc.
LLM_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
CHEAP_MODEL=gpt-4o-mini

# Embeddings are optional. If the provider has no embeddings endpoint,
# set EMBEDDING_ENABLED=false and retrieval falls back to BM25 + RRF.
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=text-embedding-3-small

# Demo knobs
TOP_K=5
MAX_TOKENS=1800
TARGET_ACOS=0.30
API_BASE_URL=http://localhost:8000
